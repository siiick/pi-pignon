{
  "name": "pignon",
  "description": "Pi extension that shifts to the right model for each prompt, using a local (Laya) or remote (Jev) decision model",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.vitest",
    "build": "echo 'nothing to build (TypeScript runs via jiti)'",
    "check": "tsc --noEmit && vitest run && npm run test:worker",
    "test:worker": "cd worker && .venv/bin/python -m unittest",
    "schema": "UPDATE_SCHEMA=1 vitest run tests/schema.test.ts"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "typebox": "^1.3.34"
  }
}
